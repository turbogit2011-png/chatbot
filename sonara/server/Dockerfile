FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY sonara_server ./sonara_server

ENV SONARA_HOST=0.0.0.0 \
    SONARA_PORT=8000 \
    SONARA_DATA_DIR=/data \
    SONARA_ENGINE=auto

VOLUME ["/data"]
EXPOSE 8000

CMD ["python", "-m", "uvicorn", "sonara_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
